+// A bounded local fallback also covers lost filesystem notifications and
+// external symlink rotation. It never replaces a working pair on a bad read.
+func (c *STDServerConfig) pollCertificate() {
+	if c.certificatePath == "" && c.keyPath == "" {
+		return
+	}
+	now := time.Now().UnixNano()
+	next := c.nextCertificateCheck.Load()
+	if now < next || !c.nextCertificateCheck.CompareAndSwap(next, now+int64(time.Second)) {
+		return
+	}
+	path := c.certificatePath
+	if path == "" {
+		path = c.keyPath
+	}
+	_ = c.certificateUpdated(path)
