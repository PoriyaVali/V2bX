diff --git a/transport/v2rayhttp/conn_context_test.go b/transport/v2rayhttp/conn_context_test.go
new file mode 100644
--- /dev/null
+++ b/transport/v2rayhttp/conn_context_test.go
@@ -0,0 +1,31 @@
+package v2rayhttp
+
+import (
+	"context"
+	"testing"
+
+	"github.com/sagernet/sing-box/log"
+)
+
+type inboundValue struct{}
+
+// 🔴 Regression: a connection taken over from an HTTP request keeps the
+// inbound's context values and outlives the request. DupContext rebuilt it
+// from context.Background(), so V2bX, which refuses a connection without its
+// node-generation value, refused every user of a WebSocket, HTTPUpgrade or
+// HTTP node.
+func TestDupContextKeepsValuesAndDropsCancellation(t *testing.T) {
+	inbound := context.WithValue(context.Background(), inboundValue{}, "generation")
+	request, cancel := context.WithCancel(log.ContextWithNewID(inbound))
+	dup := DupContext(request)
+	cancel()
+	if dup.Value(inboundValue{}) != "generation" {
+		t.Fatal("the inbound's context value was dropped")
+	}
+	if _, loaded := log.IDFromContext(dup); !loaded {
+		t.Fatal("the log ID was dropped")
+	}
+	if dup.Err() != nil {
+		t.Fatal("the connection's context ends with the request")
+	}
+}
