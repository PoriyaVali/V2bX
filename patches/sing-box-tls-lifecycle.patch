+// A bounded local fallback also covers lost filesystem notifications and
+// external symlink rotation. It never replaces a working pair on a bad read.
+func (c *STDServerConfig) pollCertificate() {
+	if c.certificatePath == "" && c.keyPath == "" {
+		return
+	}
+	now := time.Now().UnixNano()
+	next := c.nextCertificateCheck.Load()
+	if now < next || !c.nextCertificateCheck.CompareAndSwap(next, now+int64(time.Second)) {
+		return
+	}
+	path := c.certificatePath
+	if path == "" {
+		path = c.keyPath
+	}
+	_ = c.certificateUpdated(path)
+}
+
+func validServerPair(pair *tls.Certificate, serverName string) error {
+	leaf := pair.Leaf
+	if leaf == nil {
+		var err error
+		leaf, err = x509.ParseCertificate(pair.Certificate[0])
+		if err != nil {
+			return err
+		}
+	}
+	now := time.Now()
+	if now.Before(leaf.NotBefore) || !now.Before(leaf.NotAfter) {
+		return E.New("TLS certificate is not currently valid")
+	}
+	if len(leaf.ExtKeyUsage) > 0 || len(leaf.UnknownExtKeyUsage) > 0 {
+		serverAuth := false
+		for _, usage := range leaf.ExtKeyUsage {
+			if usage == x509.ExtKeyUsageServerAuth || usage == x509.ExtKeyUsageAny {
+				serverAuth = true
+			}
+		}
+		if !serverAuth {
+			return E.New("TLS certificate does not permit server authentication")
+		}
+	}
+	if serverName != "" {
+		if err := leaf.VerifyHostname(serverName); err != nil {
+			return E.Cause(err, "TLS certificate hostname mismatch")
+		}
 	}
 	return nil
 }
