@@ -0,0 +1,23 @@
+package v2raygrpclite
+
+import (
+	"bytes"
+	"io"
+	"testing"
+)
+
+// 🔴 Regression: a client's read waits for the response that gives it its
+// reader. It tested the reader for nil while the response's goroutine set
+// it, which the race detector reported for every gRPC connection.
+func TestLateConnReadWaitsForTheResponse(t *testing.T) {
+	conn := newLateGunConn(io.Discard)
+	done := make(chan error, 1)
+	go func() {
+		_, err := conn.Read(make([]byte, 16))
+		done <- err
+	}()
+	conn.setup(bytes.NewReader(nil), nil)
+	if err := <-done; err == nil {
+		t.Fatal("read an empty response without an error")
+	}
+}
