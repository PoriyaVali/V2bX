diff --git a/proxy/vision_filter_race_test.go b/proxy/vision_filter_race_test.go
new file mode 100644
--- /dev/null
+++ b/proxy/vision_filter_race_test.go
@@ -0,0 +1,41 @@
+package proxy
+
+import (
+	"context"
+	"sync"
+	"testing"
+
+	"github.com/xtls/xray-core/common/buf"
+)
+
+// A connection's reader and its writer both run XtlsFilterTls on what passes
+// and both read what it has learned, each on its own goroutine. They did so
+// with no lock (run with -race): on every Vision connection carrying TLS.
+func TestVisionFilterStateIsSharedSafely(t *testing.T) {
+	state := NewTrafficState(make([]byte, 16))
+	record := func() buf.MultiBuffer {
+		b := buf.New()
+		// A TLS application data record's start.
+		_, _ = b.Write([]byte{0x17, 0x03, 0x03, 0x00, 0x10, 0x00, 0x00, 0x00})
+		return buf.MultiBuffer{b}
+	}
+	var wg sync.WaitGroup
+	for i := 0; i < 2; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for j := 0; j < 200; j++ {
+				if state.packetsToFilter() > 0 {
+					mb := record()
+					XtlsFilterTls(mb, state, context.Background())
+					buf.ReleaseMulti(mb)
+				}
+				_, _, _, _ = state.filtered()
+			}
+		}()
+	}
+	wg.Wait()
+	if left := state.packetsToFilter(); left > 0 {
+		t.Fatalf("%d packets left to filter after far more than eight passed", left)
+	}
+}
