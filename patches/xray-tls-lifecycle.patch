diff --git a/transport/internet/grpc/encoding/closesend_test.go b/transport/internet/grpc/encoding/closesend_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/grpc/encoding/closesend_test.go
@@ -0,0 +1,59 @@
+package encoding
+
+import (
+	"context"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/xtls/xray-core/common/buf"
+)
+
+// stream records a CloseSend that runs while a Send is in progress, which a
+// gRPC client stream does not allow.
+type stream struct {
+	sending atomic.Bool
+	overlap atomic.Bool
+}
+
+func (s *stream) Context() context.Context { return context.Background() }
+func (s *stream) send() error {
+	s.sending.Store(true)
+	time.Sleep(time.Millisecond)
+	s.sending.Store(false)
+	return nil
+}
+func (s *stream) Send(*Hunk) error            { return s.send() }
+func (s *stream) Recv() (*Hunk, error)        { select {} }
+func (s *stream) SendMsg(m interface{}) error { return nil }
+func (s *stream) RecvMsg(m interface{}) error { return nil }
+func (s *stream) CloseSend() error {
+	if s.sending.Load() {
+		s.overlap.Store(true)
+	}
+	return nil
+}
+
+type multiStream struct{ stream }
+
+func (s *multiStream) Send(*MultiHunk) error     { return s.send() }
+func (s *multiStream) Recv() (*MultiHunk, error) { select {} }
+
+// 🔴 Regression: closing a gRPC connection while it writes. Close called
+// CloseSend during a Send, a data race in the gRPC client.
+func TestCloseSendWaitsForSend(t *testing.T) {
+	for i := 0; i < 20; i++ {
+		s := &stream{}
+		h := NewHunkReadWriter(s, func() {})
+		go h.Write([]byte("x"))
+		m := &multiStream{}
+		mh := NewMultiHunkReadWriter(m, func() {})
+		go mh.WriteMultiBuffer(buf.MultiBuffer{buf.New()})
+		time.Sleep(200 * time.Microsecond)
+		h.Close()
+		mh.Close()
+		if s.overlap.Load() || m.overlap.Load() {
+			t.Fatal("CloseSend ran during a Send")
+		}
+	}
+}
