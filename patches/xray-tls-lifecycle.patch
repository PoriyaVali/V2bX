diff --git a/transport/internet/kcp/receiving_release_test.go b/transport/internet/kcp/receiving_release_test.go
new file mode 100644
--- /dev/null
+++ b/transport/internet/kcp/receiving_release_test.go
@@ -0,0 +1,51 @@
+package kcp
+
+import (
+	"sync"
+	"testing"
+
+	"github.com/xtls/xray-core/common/buf"
+)
+
+type noOpCloser struct{}
+
+func (noOpCloser) Close() error { return nil }
+
+// 🔴 Regression: an mKCP connection torn down while it is being read.
+// ReadMultiBuffer and Read took leftOver outside the lock Release clears it
+// under; the race detector reported it whenever a node's listener closed
+// with a connection still reading.
+func TestReceivingWorkerReleaseDuringRead(t *testing.T) {
+	conn := NewConnection(ConnMetadata{Conversation: 1}, buf.DiscardBytes, noOpCloser{}, &Config{
+		Mtu:              1350,
+		Tti:              50,
+		UplinkCapacity:   5,
+		DownlinkCapacity: 20,
+		CwndMultiplier:   20,
+		MaxSendingWindow: 2 * 1024 * 1024,
+	})
+	defer conn.Terminate()
+	w := conn.receivingWorker
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 2000; i++ {
+			w.Lock()
+			w.leftOver = buf.MultiBuffer{buf.New()}
+			w.Unlock()
+			if i%2 == 0 {
+				buf.ReleaseMulti(w.ReadMultiBuffer())
+			} else {
+				w.Read(make([]byte, 1))
+			}
+		}
+	}()
+	go func() {
+		defer wg.Done()
+		for i := 0; i < 2000; i++ {
+			w.Release()
+		}
+	}()
+	wg.Wait()
+}
